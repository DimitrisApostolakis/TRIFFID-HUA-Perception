FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive

# System deps (OpenCV needs libgl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CUDA-enabled PyTorch (GPU inference, e.g. video mode on 4K footage). The
# cu121 wheels bundle their own CUDA runtime libraries, so a plain python
# base image works as long as the container is started with the NVIDIA
# runtime (see docker-compose.uav.yml). These wheels also fall back to CPU
# on hosts without a GPU, so the image stays portable.
RUN pip install --no-cache-dir \
    torch==2.2.1 torchvision==0.17.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Python deps — install after torch so ultralytics reuses the CUDA build
COPY src/triffid_uav_perception/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Source code is bind-mounted at runtime via docker-compose
# (so edits on host take effect immediately)

CMD ["bash"]
