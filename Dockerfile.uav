FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive

# System deps (OpenCV needs libgl)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    torch==2.7.1 torchvision==0.22.1 \
    --index-url https://download.pytorch.org/whl/cu126

# Lightweight IO dependencies plus the SANSA runtime (no notebook dependencies).
COPY src/triffid_uav_perception/requirements*.txt /app/
RUN pip install --no-cache-dir -r requirements-sansa.txt

# Source code is bind-mounted at runtime via docker-compose

CMD ["bash"]
